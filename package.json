{
  "name": "react-example",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "postinstall": "if [ ! -f ./node_modules/vite/bin/vite.js ]; then npm install --no-save --include=prod --include=dev --legacy-peer-deps vite@6.2.0 @vitejs/plugin-react@4.3.4 @tailwindcss/vite@4.0.9 tailwindcss@4.0.9 typescript@5.7.3; fi && mkdir -p ./node_modules/.bin && ln -sf ../vite/bin/vite.js ./node_modules/.bin/vite && chmod +x ./node_modules/vite/bin/vite.js ./node_modules/.bin/* 2>/dev/null || true",
    "prebuild": "chmod +x ./node_modules/.bin/* ./node_modules/vite/bin/vite.js 2>/dev/null || true",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@tailwindcss/vite": "4.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "22.13.5",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/three": "^0.186.0",
    "@vercel/analytics": "1.5.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "lucide-react": "0.468.0",
    "motion": "12.0.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "4.0.9",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vite": "6.2.0"
  }
}
