{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --include=prod --include=dev --legacy-peer-deps && mkdir -p ./node_modules/.bin && ln -sf ../vite/bin/vite.js ./node_modules/.bin/vite && chmod +x ./node_modules/vite/bin/vite.js ./node_modules/.bin/vite",
  "buildCommand": "node ./node_modules/vite/bin/vite.js build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
